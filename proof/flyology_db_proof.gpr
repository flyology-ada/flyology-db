with "flyology.gpr";
project Flyology_Db_Proof is
   for Languages use ("Ada");
   --  The selected deterministic DB units need the HTTP-independent Object
   --  Storage interfaces named by the root package's private representation.
   --  Do not import the complete Object Storage build project here: its
   --  client/server closure and XmlAda aggregate are outside this proof.
   for Source_Dirs use (".", "../src", "../.deps/flyology-object-storage/src");
   for Source_Files use
     ("flyology-db-lsm_format_proof.ads",
      "flyology-db.ads",
      "flyology-db-head_policy.ads",
      "flyology-db-head_policy.adb",
      "flyology-db-formats.ads",
      "flyology-db-formats.adb",
      "flyology-db-batch_formats.ads",
      "flyology-db-batch_formats.adb",
      "flyology-db-manifest_formats.ads",
      "flyology-db-manifest_formats.adb",
      "flyology-db-reference_model.ads",
      "flyology-db-reference_model.adb",
      "flyology-db-lsm_formats.ads",
      "flyology-db-lsm_formats.adb",
      "flyology-object_storage.ads",
      "flyology-object_storage-backends.ads",
      "flyology-object_storage-tags.ads");
   for Object_Dir use "obj";
   for Create_Missing_Dirs use "True";

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatwa", "-gnatw.X", "-gnatVa", "-gnatW8", "-gnatyM110");
   end Compiler;
end Flyology_Db_Proof;
