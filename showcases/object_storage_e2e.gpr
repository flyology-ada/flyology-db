with "../flyology_db.gpr";

project Object_Storage_E2E is

   for Source_Dirs use ("src");
   for Object_Dir use "obj/object_storage_e2e";
   for Exec_Dir use "bin";
   for Main use ("flyology_db_object_storage_e2e.adb");
   for Create_Missing_Dirs use "True";

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatW8", "-gnatw.e", "-gnatyM110");
   end Compiler;

end Object_Storage_E2E;
