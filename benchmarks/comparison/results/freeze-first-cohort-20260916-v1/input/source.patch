+JoinTxnPrepareState(t, keep) ==
+    [s EXCEPT !.prepareBorrow = s.prepareBorrow \ {Fragment(t)},
+        !.prepared = IF keep THEN s.prepared \cup {t} ELSE s.prepared,
+        !.pending = IF keep THEN s.pending ELSE s.pending \ {t},
