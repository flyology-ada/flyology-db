+         return;
+      elsif not Runtime_Published_By (Batch, Attempted) then
+         Release_Runtime_Batch (Batch);
+         Result := Invalid_State;
+         Fence_On_Failure := True;
+         return;
+      end if;
+   exception
+      when Storage_Error =>
+         Release_Runtime_Batch (Batch);
+         Result := Capacity_Exceeded;
+      when others =>
+         Release_Runtime_Batch (Batch);
+         Result := Storage_Failure;
