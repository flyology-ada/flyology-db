with "flyology_db.gpr";

project Flyology_DB_Benchmark is

   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("flyology_db_benchmark.adb");
   for Create_Missing_Dirs use "True";

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatW8", "-gnatw.e", "-gnatyM110", "-O3");
   end Compiler;

end Flyology_DB_Benchmark;
