with "flyology_db.gpr";
with "flyology_bench.gpr";

project Flyology_DB_Benchmark is

   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use
     ("flyology_db_benchmark.adb",
      "flyology_db_benchmark_panel.adb");
   for Create_Missing_Dirs use "True";

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatW8", "-gnatw.e", "-gnatyM110", "-O3");
   end Compiler;

   package Linker is
      for Default_Switches ("Ada") use
        ("-Lslatedb/target/release",
         "-lflyology_db_slatedb_benchmark",
         "-L../../oracles/adapters/tidesdb/build",
         "-lflyology_tidesdb_oracle",
         "-L../../oracles/adapters/tidesdb/build/upstream",
         "-ltidesdb",
         "-Wl,-rpath,@loader_path/../../../oracles/adapters/tidesdb/build/upstream");
   end Linker;

end Flyology_DB_Benchmark;
