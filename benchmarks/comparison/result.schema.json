{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://db.flyology.org/benchmarks/result.schema.json",
  "title": "Flyology.DB cross-engine benchmark result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_sha256",
    "campaign",
    "host",
    "workload",
    "results"
  ],
  "properties": {
    "schema_version": {"const": "flyology.db.benchmark.result.v1"},
    "contract_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "campaign": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "classification", "started_at_utc"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "classification": {"enum": ["directional", "isolated_host"]},
        "started_at_utc": {"type": "string", "format": "date-time"}
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "architecture", "cpu", "memory_bytes", "power"],
      "properties": {
        "os": {"type": "string", "minLength": 1},
        "architecture": {"type": "string", "minLength": 1},
        "cpu": {"type": "string", "minLength": 1},
        "memory_bytes": {"type": "integer", "minimum": 1},
        "power": {
          "type": "object",
          "additionalProperties": false,
          "required": ["os", "detector", "profile", "power_source"],
          "properties": {
            "os": {"type": "string", "minLength": 1},
            "detector": {"type": "string", "minLength": 1},
            "profile": {"type": "string", "minLength": 1},
            "power_source": {"type": ["string", "null"]}
          }
        }
      }
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sha256",
        "seed",
        "key_bytes",
        "value_bytes",
        "key_count",
        "transaction_mutations",
        "concurrency",
        "warmup_operations",
        "measured_operations",
        "repetitions"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "seed": {"type": "integer", "minimum": 0},
        "key_bytes": {"type": "integer", "minimum": 1},
        "value_bytes": {"type": "integer", "minimum": 0},
        "key_count": {"type": "integer", "minimum": 1},
        "transaction_mutations": {"type": "integer", "minimum": 1},
        "concurrency": {"type": "integer", "minimum": 1},
        "warmup_operations": {"type": "integer", "minimum": 0},
        "measured_operations": {"type": "integer", "minimum": 1},
        "repetitions": {"type": "integer", "minimum": 1}
      }
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "lane",
          "participant",
          "engine_source",
          "adapter_source",
          "compiler",
          "build_flags",
          "storage_revision",
          "storage_configuration",
          "correctness_gate",
          "correctness_evidence",
          "dependency_sources",
          "power",
          "samples",
          "median_operations_per_second"
        ],
        "properties": {
          "lane": {"type": "string", "minLength": 1},
          "participant": {"type": "string", "minLength": 1},
          "engine_source": {"type": "string", "minLength": 1},
          "adapter_source": {"type": "string", "minLength": 1},
          "compiler": {"type": "string", "minLength": 1},
          "build_flags": {"type": "array", "items": {"type": "string"}},
          "storage_revision": {"type": "string", "minLength": 1},
          "storage_configuration": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {"type": "string", "minLength": 1}
          },
          "correctness_gate": {"type": "string", "minLength": 1},
          "correctness_evidence": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "dependency_sources": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {"type": "string", "minLength": 1}
          },
          "power": {
            "type": "object",
            "additionalProperties": false,
            "required": ["os", "detector", "profile", "power_source"],
            "properties": {
              "os": {"type": "string", "minLength": 1},
              "detector": {"type": "string", "minLength": 1},
              "profile": {"type": "string", "minLength": 1},
              "power_source": {"type": ["string", "null"]}
            }
          },
          "samples": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "repetition",
                "operations",
                "bytes",
                "elapsed_nanoseconds",
                "errors",
                "checksum"
              ],
              "properties": {
                "repetition": {"type": "integer", "minimum": 1},
                "operations": {"type": "integer", "minimum": 1},
                "bytes": {"type": "integer", "minimum": 0},
                "elapsed_nanoseconds": {"type": "integer", "minimum": 1},
                "errors": {"type": "integer", "const": 0},
                "checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
              }
            }
          },
          "median_operations_per_second": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      }
    }
  }
}
